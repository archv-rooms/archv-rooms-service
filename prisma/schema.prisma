generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  price         Float
  description   String
  accessLevel   Int
  subscriptions Subscription[]
  games         Game[]
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

model Game {
  id           Int     @id @default(autoincrement())
  title        String
  platform     String
  year         Int
  developer    String
  downloadLink String
  coverUrl     String
  description  String
  sizeMb       Int
  downloads    Int     @default(0)
  status       String  @default("active")
  accessLevel  Int     @default(0)
  planId       Int?
  plan         Plan?   @relation(fields: [planId], references: [id])
}

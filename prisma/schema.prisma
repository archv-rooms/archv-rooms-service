generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  games GameCategory[]
}

model GameCategory {
  gameId     Int
  categoryId Int
  game       Game     @relation(fields: [gameId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([gameId, categoryId])
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          String         @default("user")
  avatar        String? 
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  price         Float
  description   String
  accessLevel   Int
  subscriptions Subscription[]
  games         Game[]
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

model Game {
  id          Int    @id @default(autoincrement())
  title       String
  console     String
  image       String
  accessLevel Int
  planId      Int?
  plan        Plan?  @relation(fields: [planId], references: [id])
  categories  GameCategory[] 
}